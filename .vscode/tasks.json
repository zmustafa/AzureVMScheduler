{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Azure VM Scheduler: backend",
      "type": "shell",
      "command": "python",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Azure VM Scheduler: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
