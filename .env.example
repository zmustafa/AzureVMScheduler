# Copy to .env and change the bootstrap password before first run.
APP_NAME=Azure VM Scheduler
ENVIRONMENT=development
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345
SESSION_HOURS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true

# Safety gates. Both stay false until you deliberately enable them; each is also ANDed with the
# per-tenant permission, so turning one on here is necessary but not sufficient.
ENABLE_REAL_AZURE_STARTS=false
ENABLE_REAL_AZURE_STOPS=false

SCHEDULER_POLL_SECONDS=15
SCHEDULER_LEASE_SECONDS=900
SCHEDULER_MAX_CONCURRENCY=4
VM_MONITOR_TIMEOUT_SECONDS=600
VM_MONITOR_INTERVAL_SECONDS=15

# Database. Omit for SQLite at .data/azureops.db (the local default).
# PostgreSQL is what the Azure deployment uses:
# DATABASE_URL=postgresql+asyncpg://azureops:azureops@127.0.0.1:5432/azureops

# Writable state: SQLite file, the Fernet key, and the connection/connector registries.
# DATA_DIR=/app/.data

# Optional stable Fernet key for secrets at rest. If omitted, .data/secret.key is generated once.
# Rotating this invalidates stored Azure credentials — re-enter them afterwards.
# FERNET_KEY=

# Where the UI is served from, used for OIDC redirects and return-URL validation.
APP_BASE_URL=http://127.0.0.1:5173
ALLOWED_RETURN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
